# Copy this file to ".env.local" and fill in real values.
# ".env.local" is git-ignored -- never commit real secrets.

# Neon (Postgres) connection string. Vercel injects this automatically once
# you add the Neon integration from the Marketplace; for local dev, copy the
# connection string from your Neon project dashboard.
DATABASE_URL=

# Random secret Auth.js uses to sign session tokens. Generate one with:
#   npx auth secret
AUTH_SECRET=

# OPTIONAL -- only needed if you want the app to actually send emails
# (account verification, password reset). Leave both blank and the app still
# works: new accounts are verified immediately instead of by email, and the
# "forgot password" link is hidden (there'd be no way to deliver a reset
# link without an email provider). Fill them in and get: real verification
# emails, real password-reset emails. Free tier at resend.com is enough.
RESEND_API_KEY=

# Email address emails are sent from. Only used if RESEND_API_KEY is set.
# "onboarding@resend.dev" works out of the box for testing, no domain
# verification needed. A real project would use its own verified domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public base URL of the app, only needed for local dev so email links point
# somewhere valid, e.g. http://localhost:3000. On Vercel this is
# auto-detected -- no need to set it there.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL -- "Sign in with Microsoft" (Microsoft Entra ID). Leave all three
# blank to just not offer that button; email+password keeps working either
# way. Don't register your own app in the Azure portal -- ask whoever
# administers your organization's Entra ID for these 3 values (see
# docs/microsoft-entra-id-setup.md if that's you).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
